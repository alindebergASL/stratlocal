# Copy to deploy/.env on the server. gitignored.
#
# The app's own .env.example documents what each AI setting means; this is only
# what the deployment needs on top.

# The public name. Used for the certificate, and baked into the build for
# serverActions.allowedOrigins — so changing it means rebuilding, not just
# restarting.
APP_HOSTNAME=strategy.example.com

# The first people, created once on an empty database, both as admins. Add
# everyone else (any number) under Settings, Team; these are not read again.
USER1_EMAIL=
USER1_PASSWORD=
USER1_NAME=Alex
USER2_EMAIL=
USER2_PASSWORD=
USER2_NAME=Jamie

# Bedrock reaches AWS through the instance role. No keys here.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-opus-5-5

# Optional verified USD-per-million-token rates for this exact model id.
# Leave blank to retain the app's labelled list-price estimate.
AI_PRICE_US_ANTHROPIC_CLAUDE_OPUS_5_5_INPUT=
AI_PRICE_US_ANTHROPIC_CLAUDE_OPUS_5_5_OUTPUT=
AI_PRICE_US_ANTHROPIC_CLAUDE_OPUS_5_5_CACHE_READ=
AI_PRICE_US_ANTHROPIC_CLAUDE_OPUS_5_5_CACHE_WRITE=

# Web research only.
DIRECT_MODEL_ID=claude-opus-5-5
ANTHROPIC_API_KEY=
AI_PRICE_CLAUDE_OPUS_5_5_INPUT=
AI_PRICE_CLAUDE_OPUS_5_5_OUTPUT=
AI_PRICE_CLAUDE_OPUS_5_5_CACHE_READ=
AI_PRICE_CLAUDE_OPUS_5_5_CACHE_WRITE=
# Per-request tool charges. Both default to the published rates ($10 per
# 1,000 searches; a fetch costs only its tokens), so leave these blank unless
# your rate differs.
AI_PRICE_WEB_SEARCH_PER_1K_USD=
AI_PRICE_WEB_FETCH_PER_1K_USD=

AI_DAILY_CAP_CENTS=1500
# Starting values for the monthly budget. After the first save on the
# Assistants page, the page's numbers win and these are ignored.
AI_MONTHLY_CAP_CENTS=25000
AI_PEOPLE_SHARE_CENTS=10000

# Lets assistants run on their own. Any random string of 32+ characters, e.g.
# `openssl rand -hex 32`. Blank: the scheduler waits and assistants only run
# when someone presses Run now.
SCHEDULER_SECRET=
SCHEDULER_INTERVAL_SECONDS=300

# Seals each person's Slack or Teams webhook address at rest (AES-256-GCM).
# `openssl rand -base64 32`. Blank: nobody can connect Slack or Teams.
# Changing it makes saved connections unreadable; each person reconnects.
INTEGRATIONS_KEY=

# Calendars. A published iCal link (Outlook or Google) needs nothing here.
# Strategy's own Outlook mailbox: an Entra app registration with the Graph
# application permission Calendars.Read, restricted by IT to that one mailbox.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# A Google calendar shared with Strategy: a service account key (the JSON, or
# the JSON base64-encoded on one line). It sees only calendars shared with it.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Reading email (DECISIONS #102) uses the same two credentials:
# - Microsoft 365: add the Graph application permission Mail.Read to the same
#   app registration, and have IT limit it with an ApplicationAccessPolicy to
#   the mailboxes of the people who opt in.
# - Gmail: in the Workspace admin console, grant the service account's client
#   ID domain-wide delegation for https://www.googleapis.com/auth/gmail.readonly.
# Sending (DECISIONS #103), for people who also turn on "Send from my mailbox":
# - Microsoft 365: add Mail.Send and Calendars.ReadWrite to the same app
#   registration, limited by the same ApplicationAccessPolicy.
# - Gmail: add https://www.googleapis.com/auth/gmail.send and
#   https://www.googleapis.com/auth/calendar.events to the delegation.
# Nothing is sent unless a person presses Send on one draft.
# Each person then turns it on under Settings → Connections. Kept email bodies
# are deleted after 30 days, so backups hold at most that much.
# Your own email domains beyond the users' (comma-separated): events with
# nobody from outside them are internal and skipped.
INTERNAL_EMAIL_DOMAINS=
# Optional: Salesforce, used only once someone turns it on under Settings,
# Salesforce. REST: a connected app with the client-credentials flow, its
# run-as user limited to what this team may see; the login URL is your My
# Domain (https://...my.salesforce.com) or https://login.salesforce.com.
SALESFORCE_LOGIN_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Or a Salesforce MCP server over HTTPS, with a bearer token.
SALESFORCE_MCP_URL=
SALESFORCE_MCP_TOKEN=
APP_TIMEZONE=America/Los_Angeles
FISCAL_YEAR_START_MONTH=8

# Where the nightly snapshot goes. Leave it empty and the backup still runs,
# but it lands on the same disk as the database it came from, which protects
# against a mistake and not against losing the box.
BACKUP_S3_URI=
# Optional: a KMS key id or ARN to encrypt offsite snapshots with. Empty uses
# S3's own keys (AES256). Either way the backup refuses an unencrypted copy.
BACKUP_S3_KMS_KEY=
BACKUP_KEEP=14
BACKUP_INTERVAL_SECONDS=86400
