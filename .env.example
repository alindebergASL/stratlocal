# StrategyLocal development configuration. Copy to .env.local.
# Cloud AI is OFF by default, even if AWS/API credentials are present.
# No Bedrock, Anthropic, S3, or MyAgent API credentials are required.
STRATEGY_LOCAL_ONLY=1
NEXT_TELEMETRY_DISABLED=1
AWS_EC2_METADATA_DISABLED=true
AI_DAILY_CAP_CENTS=0
AI_FAKE=0

# Keep the database and original documents outside build outputs.
DB_PATH=./data/strategy.sqlite

# Choose your own local login. Seeded only when the users table is empty.
USER1_EMAIL=you@example.com
USER1_NAME=Local User
USER1_PASSWORD=

APP_TIMEZONE=America/Los_Angeles
FISCAL_YEAR_START_MONTH=8

# Prompt MyAgent separately and bring the results into this app.
# See docs/myagent-import.md for the supported JSON format and reference files.
# For Docker Desktop, use deploy/local/README.md and its password-file setup.
